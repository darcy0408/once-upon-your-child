{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "gh_grep": {
      "type": "remote", 
      "url": "https://mcp.grep.app",
      "enabled": false
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/mnt/c/dev/story-weaver-app"],
      "enabled": true
    },
    "sqlite": {
      "type": "local",
      "command": ["npx", "-y", "@bytebase/dbhub@0.16.0", "--transport", "stdio", "--dsn", "sqlite:///C:/dev/story-weaver-app/instance/app.db"],
      "enabled": true
    }
  },
  "tools": {
    "context7": true,
    "gh_grep": true,
    "filesystem": true,
    "sqlite": true
  }
}
