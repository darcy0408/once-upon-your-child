<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  App Store export options for Once Upon YOUR Child (team JPU8WX66BX).

  USED BY .github/workflows/ios-testflight.yml (via the flutter build ipa
  export-options-plist flag) since 2026-09-01. Manual signing: CI has no
  Apple ID account, so automatic signing fails with "No Accounts" — the
  profile below must match the one installed by the workflow AND the
  PROVISIONING_PROFILE_SPECIFIER in Runner.xcodeproj's Release config.

  `method` below is the modern Xcode 15.3+ spelling; older Xcode wants
  `app-store` instead.

  (XML comments cannot contain a double hyphen, so command flags are described
  in prose here rather than written out literally.)
-->
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>

    <key>teamID</key>
    <string>JPU8WX66BX</string>

    <key>signingStyle</key>
    <string>manual</string>

    <key>signingCertificate</key>
    <string>Apple Distribution</string>

    <key>provisioningProfiles</key>
    <dict>
        <key>com.storyweaver.storyWeaverApp</key>
        <string>Once Upon YOUR Child App Store</string>
    </dict>

    <key>destination</key>
    <string>export</string>

    <!-- Upload dSYMs so Sentry can symbolicate release crashes. -->
    <key>uploadSymbols</key>
    <true/>

    <!-- Let Apple thin the bundle per device. -->
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
