# Story Weaver — Production Environment Variables
# Copy to .env and fill in values.
# See docs/env_vars_reference.md for full details.

# =============================================
# 🔴 CRITICAL — App won't work without these
# =============================================
FLASK_ENV=production
JWT_SECRET_KEY=           # python -c "import secrets; print(secrets.token_hex(32))"
GEMINI_API_KEY=           # Google Gemini API key
# DATABASE_URL=           # Auto-set by Railway Postgres plugin

# =============================================
# 🟡 RECOMMENDED — Features degraded without
# =============================================
# STRIPE_SECRET_KEY=      # sk_live_...
# STRIPE_WEBHOOK_SECRET=  # whsec_...
# STRIPE_PRICE_ID_PREMIUM=
# STRIPE_PRICE_ID_FAMILY=
# REDIS_URL=              # Auto-set by Railway Redis plugin
# SENTRY_DSN=             # https://key@sentry.io/id
# OPENROUTER_API_KEY=     # For image generation (preferred over Gemini)
# RESEND_API_KEY=         # Resend API key — sends the COPPA parental-consent
#                         # verification email. WITHOUT THIS, under-13 signups
#                         # cannot complete (request-verification returns 503).
#                         # Create at resend.com -> API Keys.
# CONSENT_EMAIL_FROM=     # From address for consent emails, e.g.
#                         # "Once Upon YOUR Child <no-reply@yourdomain.com>".
#                         # The domain MUST be verified in the Resend dashboard.
#                         # Defaults to no-reply@storyweaver.app if unset.

# =============================================
# 🟢 OPTIONAL — Sensible defaults exist
# =============================================
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_MODEL_FREE=gemini-2.5-flash-lite  # Cheaper model for free-tier text gen
# MT-171 Phase 1: provider switch for story-text generation.
#   gemini     — legacy: Gemini -> OpenRouter -> static fallback (default).
#   openrouter — target: OpenRouter -> static (skip Gemini; ToS-compliant for
#                child-directed apps).
#   auto       — rollback-safe: OpenRouter -> Gemini -> static (validation).
# Gemini's API Additional Terms prohibit child-directed apps; flipping this to
# 'openrouter' is the L-AI-01 legal-blocker fix. Requires OPENROUTER_API_KEY.
# See audit/MT-171-OPENROUTER-MIGRATION-BRIEF.md for the full plan.
# STORY_GEN_PROVIDER=gemini
# OPENROUTER_PAID_MODEL=anthropic/claude-sonnet-4.7        # paid/premium/family/byok tier
# OPENROUTER_FREE_MODEL=meta-llama/llama-3.3-70b-instruct  # free tier
# STRIPE_TRIAL_DAYS=14
# ELEVENLABS_API_KEY=     # TTS narration
# REPLICATE_API_TOKEN=    # Avatar gen + Flux Schnell illustration fallback
# Cloudflare Workers AI — primary Flux Schnell illustration provider (MT-131).
# Free daily Neuron allocation covers current scale at $0. Create the token at
# dash.cloudflare.com -> My Profile -> API Tokens -> Workers AI template.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_FLUX_DISABLED=false   # kill-switch: skip Cloudflare, use Replicate
# FLUX_SCHNELL_DISABLED=false      # kill-switch: skip Replicate Flux Schnell
# SYNC_STORY_TIMEOUT_SECONDS=120
# Companion-heavy stories add mandatory validation names and a larger prompt,
# which routinely forces an extra regeneration. The sync timeout is extended
# per companion (pets + characters), capped, so these legitimately-slower
# requests finish in the sync path instead of restarting on the async worker.
# SYNC_STORY_TIMEOUT_PER_COMPANION_SECONDS=30
# SYNC_STORY_TIMEOUT_MAX_EXTRA_SECONDS=120
# GEMINI_REQUEST_TIMEOUT_SECONDS=90
# GEMINI_IMAGE_REQUEST_TIMEOUT_SECONDS=120
# MT-155: best-effort photo-analysis vision call timeout for custom-avatar
# generation. Kept short so it cannot eat the avatar route's 30s budget; on
# timeout generation proceeds without the (optional) photo descriptors.
# AVATAR_PHOTO_ANALYSIS_TIMEOUT_SECONDS=12
# DISABLE_GEMINI_IMAGE=false
# MOCK_TESTING_MODE=false
# COPPA_REQUIRE_VERIFIED_CONSENT=false  # When true, the COPPA gate requires a
#                         # verified=True consent record for under-13 users.
#                         # Keep false during the tester phase (self_attested
#                         # consent). Set true for launch, together with the
#                         # Flutter _kSkipEmailConsent flag. See CMP-2.
# COPPA_REQUIRE_CURRENT_POLICY_VERSION=false  # CMP-10. When true, the COPPA
#                         # gate rejects under-13 consent records whose
#                         # policy_version is older than the backend's
#                         # CURRENT_POLICY_VERSION (or NULL) — a privacy-policy
#                         # update then forces fresh parental consent. Keep
#                         # false during the tester phase; enable it together
#                         # with bumping CURRENT_POLICY_VERSION in
#                         # backend/models/consent_record.py.
# DATA_RETENTION_INACTIVE_DAYS=730  # CMP-5 / PP-13. Inactivity window (days)
#                         # before an account's data is auto-purged by the
#                         # daily Celery-beat retention job. Defaults to 730
#                         # (2 years) to match PRIVACY_POLICY.md. Requires the
#                         # Celery worker to run with the embedded beat
#                         # scheduler (celery worker -B).
