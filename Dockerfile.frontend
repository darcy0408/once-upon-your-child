# Flutter Web Frontend Dockerfile for Railway
FROM ghcr.io/cirruslabs/flutter:stable AS build

# Set working directory
WORKDIR /app

# Copy pubspec files and path dependencies needed for pub get
COPY pubspec.yaml pubspec.lock ./
COPY third_party/ third_party/

# Get dependencies
RUN flutter pub get

# Copy the rest of the application
COPY . .

# Clean any cached builds and analyze issues
RUN flutter clean && flutter pub get

# Accept backend URL as a build argument
ARG BACKEND_URL
# If not provided, it will fallback to the default in FlavorConfig,
# but for production it really should be provided.

# Build the web app with the custom backend URL
RUN flutter build web --release \
    --dart-define=FLUTTER_WEB_USE_SKIA=true \
    --dart-define=FLAVOR=production \
    --dart-define=CUSTOM_BACKEND_URL=$BACKEND_URL

# Stage 2: Serve with nginx (unprivileged - runs as non-root, CWE-250)
# nginxinc/nginx-unprivileged runs as UID 101 and ships a default
# config that listens on 8080 instead of the privileged port 80.
FROM nginxinc/nginx-unprivileged:alpine

# Copy the built web files from the build stage
COPY --from=build /app/build/web /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/templates/default.conf.template

# Expose port (Railway will provide PORT env var; defaults to 8080)
EXPOSE 8080

# The base image already runs as the non-root 'nginx' user (UID 101) and
# ships docker-entrypoint.sh, which runs envsubst over /etc/nginx/templates/*.template
# at startup -> /etc/nginx/conf.d/default.conf (substituting ${PORT}).
# That entrypoint runs before this CMD, so nginx.conf is rendered automatically.
# Railway's startCommand in railway.frontend.json ("nginx -g 'daemon off;'")
# overrides this CMD but still benefits from the same entrypoint.
# Note: PORT must be an unprivileged port (>1024); Railway uses 8080.
CMD ["nginx", "-g", "daemon off;"]
